# ── Server ────────────────────────────────────────────────────────────────
PORT=3100
NODE_ENV=development
APP_NAME="SL INDONESIA"
APP_TIMEZONE=Asia/Jakarta

# ── Database (MySQL) ──────────────────────────────────────────────────────
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/sl_finance"

# ── JWT ───────────────────────────────────────────────────────────────────
JWT_SECRET=ubah-ini-dengan-string-random-panjang-minimal-32-karakter
JWT_EXPIRES_IN=1d

# ── Kebijakan akun ────────────────────────────────────────────────────────
# Password default untuk NIP yang baru diimport dari HRIS.
# User wajib menggantinya saat login pertama kali.
DEFAULT_PASSWORD=ganti-password-awal-anda
MIN_PASSWORD_LENGTH=6

# ── Aturan pengajuan ──────────────────────────────────────────────────────
# Batas hari untuk menyerahkan LPJ setelah dana dicairkan
LPJ_DUE_DAYS=14
# Prefix nomor pengajuan -> SLI/FIN/2026/07/0001
REQUEST_NUMBER_PREFIX=SLI/FIN

# ── Cloudflare R2 (S3-compatible) ─────────────────────────────────────────
# Isi setelah bucket dibuat di dashboard Cloudflare.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Bucket lampiran pendukung saat pengajuan (quotation, penawaran, dll)
R2_BUCKET_DOCUMENT=finance-dokumen
# Bucket bukti transaksi LPJ (nota, struk, invoice)
R2_BUCKET_LPJ=finance-lpj
# Bucket bukti transfer dari finance/direktur
R2_BUCKET_TRANSFER=finance-transfer

DOWNLOAD_URL_EXPIRES_SECONDS=3600
# 25 MB per file
MAX_UPLOAD_BYTES=26214400
