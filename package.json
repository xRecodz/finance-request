{
  "name": "finance-request-sl-indonesia",
  "version": "1.0.0",
  "description": "Sistem Permohonan Dana & Barang SL INDONESIA — pengajuan, approval, pencairan, dan LPJ",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc",
    "build:web": "npm --prefix web run build",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "hris:extract": "tsx scripts/extract-hris-nip.ts",
    "approvers:sync": "tsx scripts/sync-approver-whitelist.ts",
    "admin:ensure": "tsx scripts/ensure-admin.ts",
    "categories:sync": "tsx scripts/sync-categories.ts",
    "requests:delete-by-nip": "tsx scripts/delete-requests-by-nip.ts",
    "db:dump": "mysqldump --databases sl_finance --single-transaction --routines --triggers > sl_finance.dump.sql && ls -lh sl_finance.dump.sql",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [
    "finance",
    "pengajuan",
    "approval",
    "lpj"
  ],
  "author": "SL INDONESIA",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.758.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^10.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.5.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
